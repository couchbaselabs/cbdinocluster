module github.com/couchbaselabs/cbdinocluster

go 1.27.0

// TODO(SDKQE-4006): Go 1.26 made crypto/rsa.GenerateKey ignore the io.Reader it is passed and always draw from a secure
// random source. utils/dinocerts relies on that reader to create reproducible keys. Go intends to remove this setting,
// we should update our implementation so it doesn't need this.
godebug cryptocustomrand=1

